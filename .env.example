# Base URL of the Mohandes Man API.
# Use an origin only, with no trailing slash.
# Example: https://api.example.com
# Do not commit real credentials or environment-specific secrets.
NEXT_PUBLIC_API_BASE_URL=

# Typed display fixtures for design review. Set to false when live catalog APIs exist.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Development-only mock engineer auth. Ignored in production builds.
# Primary toggles live in config/mock-auth.config/mock-auth.config.ts
NEXT_PUBLIC_ENABLE_MOCK_REGISTER=true
NEXT_PUBLIC_ENABLE_MOCK_LOGIN=true

# Development-only mock customer auth. Ignored in production builds.
NEXT_PUBLIC_ENABLE_MOCK_USER_REGISTER=true
NEXT_PUBLIC_ENABLE_MOCK_USER_LOGIN=true
